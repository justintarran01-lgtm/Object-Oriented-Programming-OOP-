4. INHERITANCE

public class Person {
    String name;


    public Person(String name){
        this.name = name;

    }

    public void introduce() {
        System.out.println(name + " is introducing himself");

    }
} 

public class Student extends Person{
    String course;



    public Student(String name, String course) {
        super(name);
        this.course = course;
    }

    public void study() {
        System.out.println(name + " is studying " + course );
    }
}

public class App {
    public static void main(String[] args) throws Exception {
        
        Student s1 = new Student("john", "computer science");

        s1.introduce();
        s1.study();
    }
}
