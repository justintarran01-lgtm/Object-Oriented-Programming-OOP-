 public class Car {

    //attributes
    private String brand;
    private double price;

    // constructor
    public Car(String brand, double price) {

        this.brand = brand;
        this.price = price;
    }


    // create getter

    public String getBrand() {
        return brand;
    }

    // create setter
    public void setBrand (String brand) {
        this.brand = brand;

        
    }

    public double getPrice () {
        return price;
    }

    public void setPrice( double price) {

        if (price >= 0) {


            this.price = price;
        }


    }

}



public class App {
    public static void main(String[] args) throws Exception {

        Car c1 = new Car ("Toyota: ", 500000);
        Car c2 = new Car ("Honda: " ,  700000);

        c2.setPrice(600000);

        System.out.println(c1.getBrand() + c1.getPrice());
        System.out.println(c2.getBrand()  +  c2.getPrice());
      
         
        
    }
}
